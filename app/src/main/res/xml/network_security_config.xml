<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- A server url is only saved as plain http for a server on this device, the local network or a private
         VPN (ConfigHandler.validateServerUrl), and AndroidPoster checks every request it sends by the same rule
         (Main.allowsPlainHttp). The WebView only shows our own pages, served from this device. The platform
         cannot name address ranges, so it permits cleartext and leaves where http may go to those. -->
    <base-config cleartextTrafficPermitted="true" />
    <!-- Never plain http to peergos.net, from anything in the app, the payment page in the WebView included -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">peergos.net</domain>
    </domain-config>
</network-security-config>
